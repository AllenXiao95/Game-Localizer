# Variable-name template. Project configuration can auto-discover a real,
# Git-ignored .env file. Never commit the populated file.

# OpenAI-compatible translation provider
LOCALIZER_API_KEY=

# GitHub Release
GITHUB_TOKEN=

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Alibaba OSS STS gateway request-header value (not a long-lived OSS AccessKey).
# Non-secret OSS_ENDPOINT/OSS_BUCKET/OSS_STS_TOKEN_API settings belong in
# project.yaml; sts_token_env below references this value by environment name.
# The name must exactly match project.yaml. The STS role needs GetObject +
# PutObject on the configured bucket/prefix for idempotency and read-back verify.
OSS_API_TOKEN_HEADER=
